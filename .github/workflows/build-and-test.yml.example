name: Build and test

on:
  push:
  pull_request:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Fetch code
        uses: actions/checkout@v4

      - name: prepare java 21
        uses: actions/setup-java@v5
        with:
         java-version: '21'
         distribution: 'temurin'

      - name: Make Maven Wrapper Runnable
        run: chmod +x ./mvnw

      - name: build project
        run: ./mvnw -B clean compile

  test:
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Fetch code
        uses: actions/checkout@v4

      - name: setup-java 21
        uses: actions/setup-java@v5
        with:
          java-version: '21'
          distribution: 'temurin'

      - name: Make Maven Wrapper Runnable
        run: chmod +x ./mvnw

      - name: run tests
        run: ./mvnw -B test